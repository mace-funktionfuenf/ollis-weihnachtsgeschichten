---
import Layout from '../layouts/Layout.astro';
import ProductGrid from '../components/ProductGrid.astro';
import { getCollection, getEntry, render } from 'astro:content';

export async function getStaticPaths() {
  const [stories, posts, pages] = await Promise.all([
    getCollection('stories'),
    getCollection('posts'),
    getCollection('pages'),
  ]);

  return [
    ...stories.map((entry) => ({ params: { slug: entry.id }, props: { entry, kind: 'stories' } })),
    ...posts.map((entry) => ({ params: { slug: entry.id }, props: { entry, kind: 'posts' } })),
    ...pages.map((entry) => ({ params: { slug: entry.id }, props: { entry, kind: 'pages' } })),
  ];
}

const { entry, kind } = Astro.props;
const { Content } = await render(entry);
const author = 'author' in entry.data ? await getEntry(entry.data.author) : null;
---

<Layout title={entry.data.title} description={entry.data.seo?.metaDescription}>
  <article>
    <h1>{entry.data.title}</h1>
    {
      kind !== 'pages' && (
        <p>
          {author && <>Von {author.data.displayName ?? author.data.name} — </>}
          {'year' in entry.data && <>{entry.data.year}</>}
        </p>
      )
    }
    {'heroImage' in entry.data && entry.data.heroImage && (
      <img src={entry.data.heroImage} alt={entry.data.heroImageAlt ?? ''} loading="lazy" decoding="async" />
    )}
    <Content />
    {'products' in entry.data && entry.data.products.length > 0 && (
      <ProductGrid refs={entry.data.products} />
    )}
  </article>
</Layout>
