*OS
*.claude
# dependencies
node_modules/
vendor/

# generated: static-site build output (php bin/build.php)
/public/

# generated: local-dev runtime state (SQLite db, etc.)
/var/

# secrets — never committed. Copy config.example.php to this and fill in
# real values (DB credentials, etc.)
config.php

# local editing without GitHub round-trips (decap-server)
.cache/

# secrets — never committed, per rules/ops.md.
.env
.env.*
!.env.example

# editors / OS
.DS_Store
.vscode/

# NOTE: assets/ is NOT ignored — migrated images (uploads/, products/) are
# committed like any other source asset, since the build copies them into
# the generated public/ output.
